{
  "name": "idea-note-local",
  "version": "1.0.0",
  "description": "本地版 灵感笔记 —— 极简卡片式记录桌面应用",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win"
  },
  "license": "MIT",
  "build": {
    "appId": "com.ideanote.desktop",
    "productName": "灵感笔记",
    "directories": { "output": "dist" },
    "files": [
      "main.js",
      "app-core.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*",
      "qz/**/*"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "category": "public.app-category.productivity",
      "identity": null
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "zip", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "灵感笔记",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "linux": { "icon": "assets/icon-win.png" }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
